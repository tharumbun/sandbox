---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-8 pb-6">
      <h1 class="my-2 inline-block text-2xl font-bold sm:my-4 sm:text-3xl">
        Blogging from the heart of Cambodia
      </h1>

<h2 class="text-2xl font-semibold tracking-wide">
  <a href="https://tharum.com/blog/from-cambodia-to-the-world/">
    Words weave through the web,
    <br />Cambodia’s voice echoes,
    <br />Tharum lights the way.
  </a>
</h2>
<p class="mt-2">

<img
  src="https://img.tharum.com/wp-content/uploads/2025/05/att.ZpzC63A600OadLe1OpliMBNP9mMPgpn9WjgcuwfRswk.jpg"
  alt="Jerusalem's Old City"
  class="rounded-lg shadow-lg"
/>

<p>I began my blogging journey in June 2004 while I was a student at the National University of Management and working on a bridging digital divide project. This marked the start of my role in Cambodia’s digital media landscape.</p>
<p>Since then, I have been recognized as a pioneer in Cambodian blogging, sharing insights on media, technology, and society through my personal blog at tharum.com. My contributions have extended to international platforms like Global Voices, where I have written extensively about Cambodia's evolving digital culture.</p>
<p>Over the years, I have remained an active voice in the online community, offering commentary on Cambodia's tech scene and digital transformation.</p>

        Browse now: <LinkButton
          class="underline decoration-dashed underline-offset-4 hover:text-accent" href="https://tharum.com/blog/">my blog</LinkButton> / <a href="https://tharum.com/about">about me</a> / <a href="https://tharum.com/work">published work</a> / <a href="https://tharum.com/books/">favorite books</a> / <a href="https://tharum.com/bookmarks">my gear</a> / <a href="https://tharum.com/this-blog">this blog</a> RSS feed
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3"
        />
        <span class="sr-only">RSS Feed</span>
      </a>
      </p>

      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex flex-col sm:flex-row sm:items-center">
            <div class="mr-2 mb-1 whitespace-nowrap sm:mb-0">Stay connected:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map(({ data, id }) => (
                <Card
                  href={`/blog/${id}/`}
                  frontmatter={data}
                  secHeading={false}
                />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">My latest blog posts</h2>
          <ul>
            {recentPosts.map(
              ({ data, id }, index) =>
                index < SITE.postPerIndex && (
                  <Card
                    href={`/blog/${id}/`}
                    frontmatter={data}
                    secHeading={false}
                  />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/blog/">
        All Posts
        <IconArrowRight class="inline-block" />
      </LinkButton>
    </div>


  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
