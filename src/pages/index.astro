---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-8 pb-6">

<figure class="text-center">
<a href="https://tales.tharum.com/places/preah-vihear/">
<img
  src="https://cdn.tharum.com/img/preah-vihear/61300016.JPG"
  alt="Cambodia's Preah Vihear Temple Mount"
  class="rounded-lg shadow-lg"
/>
  <figcaption class="text-sm text-gray-500 mt-2">
Cambodia's Preah Vihear Temple Mount</a>
  </figcaption>
</figure>

      <h1 class="my-2 inline-block text-2xl font-bold sm:my-4 sm:text-3xl">
Words weave through the web,
Cambodia’s voice echoes,
Tharum lights the way.
      </h1>
<p class="mt-2">

<br /><br />
I began my blogging journey in June 2004 while I was a student at the National University of Management and working on a bridging digital divide project. This marked the start of my role in Cambodia’s digital media landscape.<br /><br />
<p>Since then, I have been recognized as a pioneer in Cambodian blogging, sharing insights on media, technology, and society through my personal blog at tharum.com. My contributions have extended to international platforms like Global Voices, where I have written extensively about Cambodia's evolving digital culture.<br /><br />
Over the years, I have remained an active voice in the online community, offering commentary on Cambodia's tech scene and digital transformation.
</p>
<br /><br />

<script async src="https://subscribe-forms.beehiiv.com/embed.js"></script><iframe src="https://subscribe-forms.beehiiv.com/3d083e41-9555-4681-805f-5aed22d63469" class="beehiiv-embed" data-test-id="beehiiv-embed" frameborder="0" scrolling="no" style="width: 560px; height: 203px; margin: 0; border-radius: 0px 0px 0px 0px !important; background-color: transparent; box-shadow: 0 0 #0000; max-width: 100%;"></iframe>

Browse: <LinkButton
          class="underline decoration-dashed underline-offset-4 hover:text-accent" href="https://tharum.com/about">about me</LinkButton> / <a href="https://tharum.com/books/">favorite books</a> / <a href="https://tharum.com/bookmarks">my gear</a> / <a href="https://tharum.com/this-blog">this blog</a> / subscribe:
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

    </section>


    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map(({ data, id }) => (
                <Card
                  href={`/blog/${id}/`}
                  frontmatter={data}
                  secHeading={false}
                />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">My latest blog posts</h2>
          <ul>
            {recentPosts.map(
              ({ data, id }, index) =>
                index < SITE.postPerIndex && (
                  <Card
                    href={`/blog/${id}/`}
                    frontmatter={data}
                    secHeading={false}
                  />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/blog/">
        All Posts
        <IconArrowRight class="inline-block" />
      </LinkButton>
    </div>


  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
