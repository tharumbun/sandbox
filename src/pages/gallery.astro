---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

type MediaItem = {
  id: number;
  title: { rendered: string };
  source_url: string;
  media_type: string;
  alt_text: string;
  caption: { rendered: string };
};

const res = await fetch('https://img.tharum.com/wp-json/wp/v2/media?per_page=20');
const mediaItems: MediaItem[] = await res.json();
---

<Layout title={`Photo Gallery | ${SITE.title}`}>
  <Header />

<main id="main-content" class="mx-auto max-w-5xl px-4 py-10">
  <h1 class="text-3xl font-bold mb-6">My photo gallery</h1>

This gallery page is a collection of some of my selected photographs taken over the years. Aside from this page, you can also check out my photolog, which includes thoughts and experiences along with the photos.

  <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4">
    {mediaItems.map((item) => (
      <div class="break-inside-avoid rounded overflow-hidden shadow-md">
        <img 
          src={item.source_url} 
          alt={item.alt_text || item.title.rendered} 
          class="w-full h-auto object-cover rounded-t"
        />
        <div class="p-2 text-sm text-gray-600" set:html={item.caption.rendered}></div>
      </div>
    ))}
  </div>
</main>



  <Footer />
</Layout>
